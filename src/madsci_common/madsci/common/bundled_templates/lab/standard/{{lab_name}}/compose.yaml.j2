# Docker Compose configuration for {{ lab_name }}
#
# Generated by: madsci new lab --template standard
# Template version: {{ template_version }}
#
# Usage:
#   docker compose up -d          # Start all services
#   docker compose down            # Stop all services
#   docker compose logs -f         # Follow all logs

services:
  # --- Infrastructure ---

  postgres:
    image: ghcr.io/ferretdb/postgres-documentdb-dev:17-ferretdb
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-madsci}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-madsci}
      POSTGRES_DB: ${POSTGRES_DB:-postgres}
    ports:
      - "5432:5432"
    network_mode: host
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U madsci"]
      interval: 5s
      timeout: 5s
      retries: 5

  ferretdb:
    image: ghcr.io/ferretdb/ferretdb:2
    ports:
      - "27017:27017"
    network_mode: host
    environment:
      - FERRETDB_POSTGRESQL_URL=postgres://madsci:madsci@localhost:5432/postgres
    depends_on:
      postgres:
        condition: service_healthy

  valkey:
    image: valkey/valkey:8
    ports:
      - "6379:6379"
    network_mode: host
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5

  # --- MADSci Managers ---

  lab_manager:
    image: ghcr.io/ad-sdl/madsci_dashboard:latest
    ports:
      - "8000:8000"
    network_mode: host
    env_file: .env
    command: python -m madsci.squid.lab_server
    depends_on:
      ferretdb:
        condition: service_started

  event_manager:
    image: ghcr.io/ad-sdl/madsci:latest
    ports:
      - "8001:8001"
    network_mode: host
    env_file: .env
    command: python -m madsci.event_manager.event_server
    depends_on:
      ferretdb:
        condition: service_started

  experiment_manager:
    image: ghcr.io/ad-sdl/madsci:latest
    ports:
      - "8002:8002"
    network_mode: host
    env_file: .env
    command: python -m madsci.experiment_manager.experiment_server
    depends_on:
      ferretdb:
        condition: service_started

  resource_manager:
    image: ghcr.io/ad-sdl/madsci:latest
    ports:
      - "8003:8003"
    network_mode: host
    env_file: .env
    command: python -m madsci.resource_manager.resource_server
    depends_on:
      postgres:
        condition: service_healthy

  data_manager:
    image: ghcr.io/ad-sdl/madsci:latest
    ports:
      - "8004:8004"
    network_mode: host
    env_file: .env
    command: python -m madsci.data_manager.data_server
    depends_on:
      ferretdb:
        condition: service_started

  workcell_manager:
    image: ghcr.io/ad-sdl/madsci:latest
    ports:
      - "8005:8005"
    network_mode: host
    env_file: .env
    command: python -m madsci.workcell_manager.workcell_server
    depends_on:
      ferretdb:
        condition: service_started
      valkey:
        condition: service_healthy

  location_manager:
    image: ghcr.io/ad-sdl/madsci:latest
    ports:
      - "8006:8006"
    network_mode: host
    env_file: .env
    command: python -m madsci.location_manager.location_server
    depends_on:
      ferretdb:
        condition: service_started

volumes:
  postgres_data:
